<?xml version="1.0" encoding="UTF-8"?>
<!--  resources/egovframework/mappers/FacilityMaMapper.xml -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="egovframework.smartbusmng.mapper.FacilityMaMapper">

    <resultMap id="FacilityMaDtoMap" type="egovframework.smartbusmng.model.facilityMa.FacilityMaDto">
        <id     column="facility_id"         property="facilityId"          jdbcType="VARCHAR"/>
        <id     column="maintain_dt"        property="maintainDt"      jdbcType="TIMESTAMP"/>
        <id     column="fault_tp"           property="faultTp"             jdbcType="VARCHAR"/>

        <result column="maintain_tp"        property="maintainTp"      jdbcType="VARCHAR"/>
        <result column="maintain_memo"      property="maintainMemo"      jdbcType="VARCHAR"/>
        <result column="maintain_person"    property="maintainPerson"     jdbcType="VARCHAR"/>
        <result column="maintain_attach"    property="maintainAttach"   jdbcType="VARCHAR"/>

        <result column="frst_regist_dt"     property="frstRegistDt"        jdbcType="TIMESTAMP"/>
        <result column="frst_user_id"       property="frstUserId"          jdbcType="VARCHAR"/>
        <result column="frst_regist_program" property="frstRegistProgram"   jdbcType="VARCHAR"/>

        <result column="last_regist_dt"     property="lastRegistDt"          jdbcType="TIMESTAMP"/>
        <result column="last_user_id"       property="lastUserId"          jdbcType="VARCHAR"/>
        <result column="last_regist_program" property="lastRegistProgrm"   jdbcType="VARCHAR"/>
    </resultMap>

    <select id="findMaByPk" resultMap="FacilityMaDtoMap">
        SELECT *
        FROM smartbusmngdb.sbm_facility_maintain
        WHERE facility_id = #{facilityId}
          AND maintain_dt = #{maintainDt}
          AND fault_tp    = #{faultTp}
    </select>

    <!-- INSERT -->
    <insert id="insertFacilityMa" parameterType="egovframework.smartbusmng.model.facilityMa.FacilityMaDto">
        INSERT INTO smartbusmngdb.sbm_facility_maintain
        <trim prefix="(" suffix=")" suffixOverrides=",">
            facility_id,
            maintain_dt,
            fault_tp,
            maintain_tp,
            <if test="maintainMemo != null">maintain_memo,</if>
            <if test="maintainPerson != null">maintain_person,</if>
            <if test="maintainAttach != null">maintain_attach,</if>
            frst_regist_dt,
            <if test="frstUserId != null">frst_user_id,</if>
            <if test="frstRegistProgram != null">frst_regist_program,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            #{facilityId},
            NOW(),
            #{faultTp},
            #{maintainTp},
            <if test="maintainMemo != null">#{maintainMemo},</if>
            <if test="maintainPerson != null">#{maintainPerson},</if>
            <if test="maintainAttach != null">#{maintainAttach},</if>
            NOW(),
            <if test="frstUserId != null">#{frstUserId},</if>
            <if test="frstRegistProgram != null">#{frstRegistProgram},</if>
        </trim>
    </insert>

    <!-- UPDATE -->
    <update id="updateFacilityMa" parameterType="egovframework.smartbusmng.model.facilityMa.FacilityMaDto">
        UPDATE smartbusmngdb.sbm_facility_maintain
        SET
            maintain_tp      = #{maintainTp},
            maintain_memo    = #{maintainMemo},
            maintain_person  = #{maintainPerson},
            <if test="maintainAttach != null">
                maintain_attach = #{maintainAttach},
            </if>
            last_regist_dt      = NOW(),
            last_user_id        = #{lastUserId},
            last_regist_program = #{lastRegistProgram}
        WHERE facility_id = #{facilityId}
          AND maintain_dt = STR_TO_DATE(#{maintainDt}, '%Y-%m-%d')
          AND fault_tp    = #{faultTp}
    </update>

    <!-- 목록 + 페이징 (offset / size 사용, MySQL 스타일) -->
    <select id="getListByFacilityId" resultMap="FacilityMaDtoMap">
        SELECT
            facility_id,
            maintain_dt,
            fault_tp,
            maintain_tp,
            maintain_memo,
            maintain_person,
            maintain_attach,
            frst_regist_dt,
            frst_user_id,
            frst_regist_program,
            last_regist_dt,
            last_user_id,
            last_regist_program
        FROM smartbusmngdb.sbm_facility_maintain
        WHERE facility_id = #{facilityId}
        ORDER BY maintain_dt DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- COUNT -->
    <select id="countMaByFacilityId"
            parameterType="java.lang.String"
            resultType="int">
        SELECT COUNT(*)
        FROM smartbusmngdb.sbm_facility_maintain
        WHERE facility_id = #{facilityId}
    </select>
</mapper>