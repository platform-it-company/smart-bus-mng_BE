<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="egovframework.smartbusmng.mapper.AdMapper">

    <resultMap id="AdMap" type="egovframework.smartbusmng.model.ad.Ad">
        <id column="ad_id" property="adId" jdbcType="VARCHAR"/>
        <result column="group_id" property="groupId" jdbcType="VARCHAR"/>
        <result column="ad_title" property="adTitle" jdbcType="VARCHAR"/>
        <result column="ad_tp" property="adTp" jdbcType="VARCHAR"/>
        <result column="default_tp" property="adDefault" jdbcType="VARCHAR"/>
        <result column="use_tp" property="useTp" jdbcType="VARCHAR"/>
        <result column="sta_de" property="eventSd" jdbcType="VARCHAR"/>
        <result column="eta_de" property="eventEd" jdbcType="VARCHAR"/>
        <result column="sta_hr" property="eventSt" jdbcType="VARCHAR"/>
        <result column="eta_hr" property="eventEt" jdbcType="VARCHAR"/>
        <result column="line_news" property="adOneline" jdbcType="VARCHAR"/>
        <result column="ad_attach" property="attchment" jdbcType="VARCHAR"/>
        <result column="frst_regist_dt" property="frstRegistDt" jdbcType="DATE"/>
        <result column="frst_user_id" property="frstUserId" jdbcType="VARCHAR"/>
        <result column="frst_regist_tool" property="frstRegistProgrm" jdbcType="VARCHAR"/>
        <result column="last_updt_dt" property="lastUpdtDt" jdbcType="DATE"/>
        <result column="last_user_id" property="lastUserId" jdbcType="VARCHAR"/>
        <result column="last_regist_tool" property="lastRegistProgrm" jdbcType="VARCHAR"/>
    </resultMap>

	<select id="getAllAds" resultMap="AdMap">
		SELECT * FROM smartbusmngdb.sbm_ad
		WHERE 1=1
		<if test="userGroupId != '' and userGroupId != null">
			AND group_id=#{userGroupId}
		</if>
		ORDER BY id DESC
	</select>
	
	<select id="getAdCount" resultType="int">
		SELECT COUNT(*) 
		FROM smartbusmngdb.sbm_ad
		WHERE 1=1
		<if test="userGroupId != '' and userGroupId != null">
			AND group_id=#{userGroupId}
		</if>
       	<if test="timeZoneType != 'all'">
       		<choose>
	           	<when test="timeZoneType == 'cur'">
	        		AND #{curDT} BETWEEN CONCAT(sta_de, sta_hr)
		                AND CONCAT(eta_de, eta_hr)
	            </when>
	        	<when test="timeZoneType == 'expired'">
					AND #{curDT} &gt; CONCAT(eta_de, eta_hr)
	           	</when>
	           	<when test="timeZoneType eq 'wait'">
					AND CONCAT(sta_de, sta_hr) &gt; #{curDT}
	           	</when>       		
       		</choose>
       		<if test="cntType != null and cntType !=''">
       			<choose>
					<when test="cntType == 'anyType'">AND ad_tp = '0'</when>
					<when test="cntType == 'oneline'">AND ad_tp = '1'</when>
					<when test="cntType == 'Image'"> AND ad_tp = '2'</when>
					<when test="cntType == 'vod'">   AND ad_tp = '3'</when>
					<when test="cntType == 'totalAd'"><!-- 전체 --></when>
       			</choose>
       		</if>    
		</if>
	</select>
	
    <select id="getAdById" parameterType="String" resultMap="AdMap">
        SELECT * FROM smartbusmngdb.sbm_ad
        WHERE ad_id = #{adId}
    		<if test="userGroupId != null and userGroupId != ''">
			AND group_id = #{userGroupId} 
		</if>
    </select>

    <!-- ✅ INSERT (수정 완료 버전) -->
    <insert id="insertAd" parameterType="egovframework.smartbusmng.model.ad.Ad">
        INSERT INTO smartbusmngdb.sbm_ad
        <trim prefix="(" suffix=")" suffixOverrides=",">
            ad_id,
            group_id,
            ad_title,
            ad_tp,
            default_tp,
            use_tp,
            <if test="eventSd != null and eventSd != ''">sta_de,</if>
            <if test="eventEd != null and eventEd != ''">eta_de,</if>
            <if test="eventSt != null and eventSt != ''">sta_hr,</if>
            <if test="eventEt != null and eventEt != ''">eta_hr,</if>
            <if test="adOneline != null and adOneline != ''">line_news,</if>
            <if test="attchment != null and attchment != ''">ad_attach,</if>
            frst_regist_dt,
            frst_user_id,
            frst_regist_tool,
            last_updt_dt,
            last_user_id,
            last_regist_tool
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            #{adId},
            #{groupId},
            #{adTitle},
            #{adTp},
            #{adDefault},
            #{useTp},
            <if test="eventSd != null and eventSd != ''">#{eventSd},</if>
            <if test="eventEd != null and eventEd != ''">#{eventEd},</if>
            <if test="eventSt != null and eventSt != ''">#{eventSt},</if>
            <if test="eventEt != null and eventEt != ''">#{eventEt},</if>
            <if test="adOneline != null and adOneline != ''">#{adOneline},</if>
            <if test="attchment != null and attchment != ''">#{attchment},</if>
            NOW(),
            #{frstUserId},
            #{frstRegistProgrm},
            NOW(),
            #{lastUserId},
            #{lastRegistProgrm}
        </trim>
    </insert>


    <!-- ✅ UPDATE -->
    <update id="updateAd" parameterType="egovframework.smartbusmng.model.ad.Ad">
        UPDATE smartbusmngdb.sbm_ad
        <trim prefix="SET" suffixOverrides=",">
            ad_title   = #{adTitle},
            ad_tp      = #{adTp},
            default_tp = #{adDefault},
            use_tp     = #{useTp},
            <if test="eventSd != null and eventSd != ''">
                sta_de = #{eventSd},
            </if>
            <if test="eventEd != null and eventEd != ''">
                eta_de = #{eventEd},
            </if>
            <if test="eventSt != null and eventSt != ''">
                sta_hr = #{eventSt},
            </if>
            <if test="eventEt != null and eventEt != ''">
                eta_hr = #{eventEt},
            </if>
            <if test="adOneline != null and adOneline != ''">
                line_news   = #{adOneline},
            </if>
            <if test="attchment != null and attchment != ''">
                ad_attach   = #{attchment},
            </if>
            last_updt_dt = NOW(),
            <if test="lastUserId != null and lastUserId != ''">
                last_user_id = #{lastUserId},
            </if>
            <if test="lastRegistProgrm != null and lastRegistProgrm != ''">
                last_regist_tool = #{lastRegistProgrm},
            </if>
        </trim>
        WHERE ad_id = #{adId}
    </update>

   	<select id="searchAds" resultMap="AdMap">
		SELECT * 
		FROM smartbusmngdb.sbm_ad
		WHERE 1=1
    		<if test="userGroupId != null and userGroupId != ''">
      			AND group_id = #{userGroupId}
    		</if>
    		<if test="ad_tp != null and ad_tp != ''">
		      	AND ad_tp = #{ad_tp}
		    </if>
		    <if test="ad_used != null and ad_used != ''">
		      	AND use_tp = #{ad_used}
		    </if>
    		<if test="ad_period != null and ad_period != ''">
	       		<choose>
		           	<when test="ad_period eq 'cur'">
		        		AND #{curDT} BETWEEN CONCAT(sta_de, sta_hr)
			                AND CONCAT(eta_de, eta_hr)
		            </when>
		        	<when test="ad_period eq 'expired'">
						AND #{curDT} &gt; CONCAT(eta_de, eta_hr)
		           	</when>
		           	<when test="ad_period eq 'wait'">
						AND CONCAT(sta_de, sta_hr) &gt; #{curDT}
		           	</when>       		
	       		</choose>
    		</if>
	  	ORDER BY last_updt_dt DESC, ad_id DESC
	  	LIMIT #{limit} OFFSET #{offset}
	</select>
    
    <select id="getSearchAdsCount" resultType="int">
       	SELECT COUNT(*) 
       	FROM smartbusmngdb.sbm_ad
		WHERE 1=1
    		<if test="userGroupId != null and userGroupId != ''">
      			AND group_id = #{userGroupId}
    		</if>
            <if test="ad_tp != '' and ad_tp != null">
                AND ad_tp = #{ad_tp}
            </if>
            <if test="ad_used != '' and ad_used != null">
                AND use_tp = #{ad_used}
            </if>
			<if test="ad_period eq 'ad_ing'">
   				TO_NUMBER(#{curDT}) BETWEEN TO_NUMBER(CONCAT(sta_de,sta_hr)) AND TO_NUMBER(CONCAT(eta_de,eta_hr))
 			</if>
			<if test="ad_period eq 'ad_done'">
			    TO_NUMBER(#{curDT}) > TO_NUMBER(CONCAT(eta_de, eta_hr))
			</if>
			<if test="ad_period eq 'ad_waiting'">
       			TO_NUMBER(CONCAT(sta_de, sta_hr)) > TO_NUMBER(#{curDT})
       		</if>
    </select>
    
    <!-- ✅ DELETE -->
    <delete id="deleteAdsById" parameterType="string">
        DELETE FROM smartbusmngdb.sbm_ad
        WHERE ad_id = #{selAdId}
    </delete>

    <delete id="deleteAdsErPrById" parameterType="string">
        DELETE FROM smartbusmngdb.sbm_facility_ad
        WHERE ad_id = #{selAdId}
    </delete>


    <!-- ✅ 첨부 관련 -->
    <delete id="deletePrefile">
        DELETE FROM fileservicedb.file_attachment
        WHERE attachment_code = #{attachCode}
          AND entity_id       = #{entityId}
          AND entity_name     = #{entityName}
          AND delete_at       = '1'
          AND attachment_id   = #{attachId}
    </delete>

    <select id="getAttchId" resultType="string">
        SELECT attachment_id
        FROM fileservicedb.file_attachment
        WHERE attachment_code = #{attachmentCode}
          AND entity_id       = #{entityId}
          AND entity_name     = #{entityName}
    </select>

    <delete id="deleteAttachment" parameterType="map">
        DELETE FROM fileservicedb.file_attachment
        WHERE attachment_code = #{attachmentCode}
          AND entity_id       = #{entityId}
          AND entity_name     = #{entityName}
    </delete>

</mapper>
