<?xml version="1.0" encoding="UTF-8"?>
<!--  resources/egovframework/mappers/RouteMapper.xml -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="egovframework.smartbusmng.mapper.RouteMapper">

	<resultMap id="RouteVOMap" type="egovframework.smartbusmng.model.route.RouteDto">
		<result column="bms_route_id" property="routeId" jdbcType="INTEGER" />
		<result column="route_ver" property="routeVer" jdbcType="INTEGER" />
		<result column="route_nm" property="routeNm" jdbcType="VARCHAR" />
		<result column="route_dc" property="routeDc" jdbcType="VARCHAR" />
		<result column="use_at" property="" jdbcType="VARCHAR" />
	</resultMap> 
	
	<resultMap id="FacilityDtoMap" type="egovframework.smartbusmng.model.facility.FacilityDto">
		<result column="facility_id" property="facilityId" jdbcType="VARCHAR" />
		<result column="group_id" property="groupId" jdbcType="VARCHAR" />
		<result column="model_id" property="modelId" jdbcType="VARCHAR" />
		<result column="model_nm" property="modelNm" jdbcType="VARCHAR" />
		<result column="manufacturer" property="manufacturer" jdbcType="VARCHAR" />
		<result column="unit_price" property="unitPrice" jdbcType="INTEGER" />
		<result column="display_res" property="displayRes" jdbcType="VARCHAR" />
		<result column="route_map_res" property="routeMapRes" jdbcType="VARCHAR" />
		<result column="ad_area_res" property="adAreaRes" jdbcType="VARCHAR" />
		<result column="use_tp" property="useTp" jdbcType="VARCHAR" />
		<result column="stat_cd" property="statCd" jdbcType="VARCHAR" />
		<result column="veh_id" property="vehId" jdbcType="INTEGER" />
	</resultMap>	
		
	<!-- 차량정보 조회 -->
    <resultMap id="BusBeanVOMap" type="egovframework.smartbusmng.model.route.BusBeanDto">
    	<id column="VEH_ID" property="vehId" jdbcType="INTEGER"/>
    	<result column="VEH_NO" property="vehNo" jdbcType="VARCHAR" />
    	<result column="GROUP_ID" property="groupId" jdbcType="VARCHAR" />
    	<result column="GROUP_NM" property="groupNm" jdbcType="VARCHAR" />
    </resultMap>  

	<select id="getAllRoutes" resultMap="RouteVOMap">
		SELECT bms_route_id, route_ver, route_nm, route_dc  
		FROM busroutedb.matched_ms_route
		WHERE use_at = '1' AND route_ver = '1'
		ORDER BY
			CASE 
				WHEN route_nm REGEXP '^[0-9]+$' THEN CAST(ROUTE_NM AS UNSIGNED)
				ELSE 99999
			END,
		route_nm
	</select>
	
	<resultMap id="busBeanInRouteVOMap" type="egovframework.smartbusmng.model.route.BusBeanInRouteDto">
		<id column="veh_id" property="vehId" jdbcType="INTEGER" />
		<result column="veh_no" property="vehNo" jdbcType="VARCHAR" />
		<result column="bms_route_id" property="routeId" jdbcType="INTEGER" />
		<result column="route_ver" property="routeVer" jdbcType="INTEGER" />
		<result column="route_nm" property="routeNm" jdbcType="VARCHAR" />
		<result column="route_dc" property="routeDc" jdbcType="VARCHAR" /> 
	</resultMap>

	<select id="getAllBusBeans" resultMap="BusBeanVOMap">
		SELECT A.VEH_ID, A.VEH_NO, A.GROUP_ID, B.GROUP_NM 
		FROM busroutedb.ms_veh A,
			 busroutedb.bms_ms_group B
		WHERE A.GROUP_ID = B.GROUP_ID
			<if test="userGroupId != null and userGroupId != 0 and userGroupId != '100000000'">
				AND A.GROUP_ID = #{userGroupId} 
				<!-- (
					SELECT group_id
					FROM smartbusmngdb.sbm_operator
					WHERE id = ${id}
				)  -->
			</if>
		ORDER BY A.VEH_NO
	</select>

	<select id="getBusBeansInRoute" resultMap="busBeanInRouteVOMap">
		SELECT A.VEH_ID, B.VEH_NO, C.BMS_ROUTE_ID, A.ROUTE_VER, C.ROUTE_NM, C.ROUTE_DC
		FROM busroutedb.bms_pr_veh_lc a, 
			busroutedb.ms_veh b, 
			busroutedb.matched_ms_route c
		WHERE A.PROVD_DT >= CURDATE()
			AND A.VEH_ID = B.VEH_ID			
 			<if test="userGroupId != null and userGroupId !=''"> 
				AND B.GROUP_ID = #{userGroupId}
			</if>
			<if test="selRouteId != 0">
				AND A.ROUTE_ID = #{selRouteId}
				AND C.BMS_ROUTE_ID = #{selRouteId}
			</if>
			<if test="selRouteVer != 0">
				AND A.ROUTE_VER = #{selRouteVer}
				AND C.ROUTE_VER = #{selRouteVer}
			</if>
		ORDER BY A.VEH_NO
	</select>

</mapper>
